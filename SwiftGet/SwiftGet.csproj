<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SwiftGet</AssemblyName>
    <RootNamespace>SwiftGet</RootNamespace>
    <ApplicationIcon>Assets\SwiftGet.ico</ApplicationIcon>
    <Version>1.2.1</Version>
    <Product>SwiftGet</Product>
    <Description>SwiftGet Download Manager</Description>
    <Copyright>Copyright © 2026 SwiftGet contributors</Copyright>
    <!-- Fluent (Windows 11) theme API is marked experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms share type names (Application, MessageBox...). Keep WinForms explicit. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\SwiftGet.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\extension\**\*" LinkBase="extension" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
