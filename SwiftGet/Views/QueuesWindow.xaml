<Window x:Class="SwiftGet.Views.QueuesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SwiftGet.Core"
        Title="{l:Tr Scheduler}" Width="900" Height="720" MinWidth="760" MinHeight="520"
        FlowDirection="{Binding Flow, Source={x:Static l:Loc.I}}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="Check" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Radio" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TimeBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="84"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- bottom bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <TextBlock Text="{l:Tr QAutoSaved}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="StartButton" Style="{StaticResource AccentButton}" Click="Start_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="{l:Tr StartNow}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Stop_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE71A;" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="{l:Tr StopNow}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{l:Tr Close}" IsCancel="True" Click="Close_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- queue list -->
            <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
                <DockPanel Margin="10,14,10,10">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource SecondaryButton}" MinWidth="0" Padding="12,0" Click="NewQueue_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="12" Margin="0,0,7,0"/>
                                <TextBlock Text="{l:Tr NewQueue}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="DeleteQueueButton" Style="{StaticResource SecondaryButton}" MinWidth="0" Width="36" Padding="0"
                                Margin="6,0,0,0" Click="DeleteQueue_Click" ToolTip="{l:Tr DeleteQueue}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="13" Foreground="{DynamicResource Danger}"/>
                        </Button>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{l:Tr NavQueues}" Style="{StaticResource H2}" Margin="8,0,0,10"/>
                    <ListBox x:Name="QueueList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource NavItem}"
                             SelectionChanged="QueueList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" FontSize="14" Margin="0,0,10,0"
                                               Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <Ellipse x:Name="Dot" Grid.Column="2" Width="8" Height="8" Margin="8,0,0,0" Fill="{DynamicResource TextTertiary}"
                                             ToolTip="{Binding StateText}"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Success}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- editor -->
            <DockPanel Grid.Column="1" Margin="22,16,22,12">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBox x:Name="NameBox" Width="300" Height="36" FontSize="15" FontWeight="SemiBold"
                             VerticalContentAlignment="Center" LostFocus="Editor_Changed" TextChanged="Name_Changed"/>
                    <Border x:Name="StatePill" Style="{StaticResource Pill}" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StateText" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <TabControl x:Name="Tabs" Padding="0,12,0,0">
                    <!-- schedule -->
                    <TabItem Header="{l:Tr TabSchedule}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource Card}">
                                    <CheckBox x:Name="StartOnLaunchBox" Style="{StaticResource Check}" Content="{l:Tr QStartOnLaunch}"
                                              Click="Editor_Changed"/>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox x:Name="StartEnabledBox" Style="{StaticResource Check}" Content="{l:Tr QStartAt}"
                                                      MinWidth="170" Click="Editor_Changed"/>
                                            <TextBox x:Name="StartTimeBox" Style="{StaticResource TimeBox}" LostFocus="Editor_Changed"/>
                                        </StackPanel>
                                        <StackPanel x:Name="StartOptions" Margin="28,12,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="OnceRadio" GroupName="mode" Style="{StaticResource Radio}" Content="{l:Tr QOnce}"
                                                             MinWidth="142" Click="Editor_Changed"/>
                                                <DatePicker x:Name="OnceDate" Width="160" SelectedDateChanged="Editor_Changed" FlowDirection="LeftToRight"/>
                                            </StackPanel>
                                            <RadioButton x:Name="DailyRadio" GroupName="mode" Style="{StaticResource Radio}" Content="{l:Tr QDaily}"
                                                         Margin="0,12,0,8" Click="Editor_Changed"/>
                                            <WrapPanel x:Name="DaysPanel" Margin="24,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="StopEnabledBox" Style="{StaticResource Check}" Content="{l:Tr QStopAt}"
                                                  MinWidth="170" Click="Editor_Changed"/>
                                        <TextBox x:Name="StopTimeBox" Style="{StaticResource TimeBox}" LostFocus="Editor_Changed"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{l:Tr QConcurrent}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <ComboBox x:Name="ConcurrentBox" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                                  SelectionChanged="Editor_Changed"/>
                                        <TextBlock Grid.Row="1" Text="{l:Tr QWhenDone}" VerticalAlignment="Center" Margin="0,12,16,0"/>
                                        <ComboBox x:Name="ActionBox" Grid.Row="1" Grid.Column="1" Width="260" HorizontalAlignment="Left"
                                                  Margin="0,12,0,0" SelectionChanged="Editor_Changed"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox x:Name="SyncBox" Style="{StaticResource Check}" Content="{l:Tr QSync}" Click="Editor_Changed"/>
                                            <ComboBox x:Name="SyncHoursBox" Width="110" Margin="12,0,0,0" SelectionChanged="Editor_Changed"/>
                                        </StackPanel>
                                        <TextBlock Text="{l:Tr QSyncHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="28,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- files -->
                    <TabItem x:Name="FilesTab" Header="{l:Tr TabFiles}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Margin="10,0,0,0">
                                <Button Style="{StaticResource SecondaryButton}" MinWidth="150" HorizontalContentAlignment="Left" Click="MoveUp_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE70E;" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="{l:Tr MoveUp}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" MinWidth="150" HorizontalContentAlignment="Left" Margin="0,8,0,0" Click="MoveDown_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="{l:Tr MoveDown}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" MinWidth="150" HorizontalContentAlignment="Left" Margin="0,8,0,0" Click="RemoveFile_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="12" Margin="0,0,8,0" Foreground="{DynamicResource Danger}"/>
                                        <TextBlock Text="{l:Tr RemoveFromQueue}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface}">
                                <Grid>
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Height="30" Background="{DynamicResource SurfaceAlt}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="#" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{l:Tr ColName}" Style="{StaticResource Caption}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{l:Tr ColSize}" Style="{StaticResource Caption}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{l:Tr ColStatus}" Style="{StaticResource Caption}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ListBox x:Name="FileList" BorderThickness="0" Background="Transparent" SelectionMode="Extended"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="bd" Background="Transparent" BorderBrush="{DynamicResource Border}"
                                                                        BorderThickness="0,0,0,1" Height="30">
                                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="44"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="100"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Position}" Margin="12,0,0,0" Foreground="{DynamicResource TextSecondary}"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding Item.CategoryGlyph}"
                                                                       Foreground="{Binding Item.CategoryBrush}" FontSize="14" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding Item.FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding Item.SizeText}"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Item.GridStatusText}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                    <TextBlock x:Name="EmptyText" Text="{l:Tr QEmpty}" Style="{StaticResource Caption}" FontSize="13"
                                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="340"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
