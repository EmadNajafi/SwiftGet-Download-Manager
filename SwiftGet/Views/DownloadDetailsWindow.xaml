<Window x:Class="SwiftGet.Views.DownloadDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SwiftGet.Core"
        xmlns:v="clr-namespace:SwiftGet.Views"
        Width="580" SizeToContent="Height" ResizeMode="CanMinimize"
        FlowDirection="{Binding Flow, Source={x:Static l:Loc.I}}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,4,18,4"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <!-- one continuous bar that fills smoothly -->
        <Style x:Key="MainProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Foreground" Value="{DynamicResource Success}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4"
                                Background="{DynamicResource Track}" Padding="1">
                            <Grid ClipToBounds="True">
                                <Border x:Name="PART_Track"/>
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Background="{TemplateBinding Foreground}">
                                    <Border CornerRadius="3">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#40FFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="0.55"/>
                                                <GradientStop Color="#18000000" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,16,18,16">
        <!-- information -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{l:Tr PdUrl}" Style="{StaticResource InfoLabel}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Url, Mode=OneWay}" Style="{StaticResource InfoValue}"
                       FlowDirection="LeftToRight" TextAlignment="Left" ToolTip="{Binding Url, Mode=OneWay}"/>
            <TextBlock Grid.Row="1" Text="{l:Tr PdStatus}" Style="{StaticResource InfoLabel}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="StatusValue" Style="{StaticResource InfoValue}" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="2" Text="{l:Tr PdFileSize}" Style="{StaticResource InfoLabel}"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SizeText, Mode=OneWay}" Style="{StaticResource InfoValue}"/>
            <TextBlock Grid.Row="3" Text="{l:Tr PdDownloaded}" Style="{StaticResource InfoLabel}"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DownloadedDetailText, Mode=OneWay}" Style="{StaticResource InfoValue}"/>
            <TextBlock Grid.Row="4" Text="{l:Tr PdRate}" Style="{StaticResource InfoLabel}"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SpeedText, Mode=OneWay}" Style="{StaticResource InfoValue}"/>
            <TextBlock Grid.Row="5" Text="{l:Tr PdTimeLeft}" Style="{StaticResource InfoLabel}"/>
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding EtaText, Mode=OneWay}" Style="{StaticResource InfoValue}"/>
            <TextBlock Grid.Row="6" Text="{l:Tr PdResume}" Style="{StaticResource InfoLabel}"/>
            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="ResumeValue" Style="{StaticResource InfoValue}"/>
        </Grid>

        <!-- progress -->
        <Grid Margin="0,14,0,0">
            <ProgressBar x:Name="MainBar" Style="{StaticResource MainProgress}"/>
            <TextBlock x:Name="PercentText" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                       FontSize="12" FlowDirection="LeftToRight"/>
        </Grid>

        <!-- buttons -->
        <DockPanel Margin="0,14,0,0" LastChildFill="False">
            <Button x:Name="DetailsButton" DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" MinWidth="140"
                    Click="DetailsToggle_Click"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{l:Tr Cancel}" IsCancel="True"
                    Click="Cancel_Click" Margin="8,0,0,0"/>
            <Button x:Name="ToggleButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Click="Toggle_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToggleGlyph" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0"/>
                    <TextBlock x:Name="ToggleText"/>
                </StackPanel>
            </Button>
        </DockPanel>

        <!-- connections (show / hide details) -->
        <StackPanel x:Name="DetailsPanel" Margin="0,16,0,0">
            <TextBlock Text="{l:Tr PdMapCaption}" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
            <v:SegmentBar x:Name="Bar" Height="10"/>
            <Border Margin="0,10,0,0" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4"
                    Background="{DynamicResource Surface}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Background="{DynamicResource SurfaceAlt}" Height="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{l:Tr ConnNo}" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{l:Tr ConnDownloaded}" Style="{StaticResource Caption}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{l:Tr ConnInfo}" Style="{StaticResource Caption}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                    <ScrollViewer Height="150" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PartList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="25">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Number}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding State}" Foreground="{Binding StateBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</Window>
