<Window x:Class="SwiftGet.Views.RefreshWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SwiftGet.Core"
        Title="{l:Tr RefreshTitle}" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        FlowDirection="{Binding Flow, Source={x:Static l:Loc.I}}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24,20,24,22">
        <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource IconTile}" Width="44" Height="44">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="20" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{l:Tr RefreshTitle}" Style="{StaticResource H2}" FontSize="18"/>
                <TextBlock x:Name="FileText" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="480"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Text="{l:Tr RefreshHelp}" Margin="0,18,0,0" TextWrapping="Wrap"/>

        <TextBlock Text="{l:Tr RefreshOld}" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="OldBox" Height="34" VerticalContentAlignment="Center" FlowDirection="LeftToRight" IsReadOnly="True"
                 Foreground="{DynamicResource TextSecondary}"/>
        <TextBlock Text="{l:Tr RefreshNew}" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NewBox" Height="36" VerticalContentAlignment="Center" FlowDirection="LeftToRight"/>

        <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{l:Tr RefreshBrowserHelp}" Style="{StaticResource Caption}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Content="{l:Tr RefreshWait}" Click="Wait_Click"/>
            </Grid>
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

        <DockPanel Margin="0,18,0,0" LastChildFill="False">
            <Button x:Name="ApplyButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{l:Tr RefreshApply}" IsDefault="True" Click="Apply_Click"/>
            <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Content="{l:Tr Cancel}" IsCancel="True"/>
        </DockPanel>
    </StackPanel>
</Window>
