<Window x:Class="SwiftGet.Views.LinksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SwiftGet.Core"
        Width="900" Height="640" MinWidth="700" MinHeight="460"
        FlowDirection="{Binding Flow, Source={x:Static l:Loc.I}}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="18,16,18,16">
        <!-- header -->
        <DockPanel DockPanel.Dock="Top">
            <Border Style="{StaticResource IconTile}" Width="42" Height="42">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE71B;" FontSize="19" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderText" Style="{StaticResource H2}" FontSize="18"/>
                <TextBlock x:Name="SubText" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- filters -->
        <DockPanel DockPanel.Dock="Top" Margin="0,14,0,8">
            <Border DockPanel.Dock="Right" Width="230" Height="34" CornerRadius="6" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="10,0,0,0">
                <Grid>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE71C;" FontSize="12" Margin="10,0,0,0"
                               HorizontalAlignment="Left" Foreground="{DynamicResource TextTertiary}"/>
                    <TextBox x:Name="FilterBox" Margin="30,0,6,0" Background="Transparent" BorderThickness="0"
                             VerticalContentAlignment="Center" Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}"
                             FlowDirection="LeftToRight" TextChanged="Filter_Changed" ToolTip="{l:Tr LinksFilterHint}">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="2,0"/>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Grid>
            </Border>
            <WrapPanel x:Name="TypeChips" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- bottom: destination + buttons -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{l:Tr FieldSaveTo}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" MinWidth="40" Width="40" Padding="0"
                            Margin="8,0,0,0" Click="Browse_Click" ToolTip="{l:Tr Browse}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" FontSize="14"/>
                    </Button>
                    <TextBox x:Name="FolderBox" Height="36" VerticalContentAlignment="Center" FlowDirection="LeftToRight"
                             ToolTip="{l:Tr LinksFolderHint}"/>
                </DockPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:Tr FieldQueue}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="QueueBox" Height="36" DisplayMemberPath="DisplayName"/>
                </StackPanel>
            </Grid>
            <DockPanel Margin="0,16,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Click="Start_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="{l:Tr StartDownload}"/>
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Content="{l:Tr DownloadLater}" Click="Later_Click"/>
                <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Content="{l:Tr Cancel}" IsCancel="True"/>
                <TextBlock x:Name="CountText" DockPanel.Dock="Left" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </DockPanel>
        </StackPanel>

        <!-- list -->
        <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource Surface}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Height="32" Background="{DynamicResource SurfaceAlt}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="AllBox" Margin="12,0,0,0" VerticalAlignment="Center" Click="All_Click" MinWidth="0"/>
                    <TextBlock Grid.Column="1" Text="{l:Tr ColName}" Style="{StaticResource Caption}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{l:Tr LinksAddress}" Style="{StaticResource Caption}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>
                <ListBox x:Name="List" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="Transparent" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Height="32">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="0" Click="Row_Click"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{Binding Brush}" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Url}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                                           FlowDirection="LeftToRight" VerticalAlignment="Center" ToolTip="{Binding Url}" Margin="0,0,10,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
