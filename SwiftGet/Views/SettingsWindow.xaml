<Window x:Class="SwiftGet.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SwiftGet.Core"
        Title="{l:Tr Settings}" Width="820" Height="600" MinWidth="700" MinHeight="500"
        FlowDirection="{Binding Flow, Source={x:Static l:Loc.I}}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource H1}">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Check" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>
        <Style x:Key="SmallBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- navigation -->
        <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <StackPanel Margin="12,20,12,12">
                <TextBlock Text="{l:Tr Settings}" Style="{StaticResource H2}" Margin="10,0,0,14"/>
                <ListBox x:Name="PageList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="PageList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="15" Margin="2,0,12,0"/>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="0,1,0,0" Padding="20,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}" IsCancel="True" Content="{l:Tr Cancel}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource AccentButton}" IsDefault="True" Content="{l:Tr Save}" Click="Save_Click"/>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22,28,22">
                <Grid>
                    <!-- General -->
                    <StackPanel x:Name="PageGeneral">
                        <TextBlock Text="{l:Tr SetGeneral}" Style="{StaticResource PageTitle}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{l:Tr SetDownloadFolder}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                            Content="{l:Tr Browse}" Click="Browse_Click"/>
                                    <TextBox x:Name="FolderBox" Height="36" VerticalContentAlignment="Center" FlowDirection="LeftToRight"/>
                                </DockPanel>
                                <CheckBox x:Name="CategoryFoldersBox" Style="{StaticResource Check}" Margin="0,12,0,0"
                                          Content="{l:Tr SetCategoryFolders}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <CheckBox x:Name="StartupBox" Style="{StaticResource Check}" Content="{l:Tr SetStartWithWindows}"/>
                                <CheckBox x:Name="ShowDialogBox" Style="{StaticResource Check}" Content="{l:Tr SetShowBrowserDialog}"/>
                                <CheckBox x:Name="ShowProgressBox" Style="{StaticResource Check}" Content="{l:Tr SetShowProgress}"/>
                                <CheckBox x:Name="ShowCompleteBox" Style="{StaticResource Check}" Content="{l:Tr SetShowComplete}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Connections -->
                    <StackPanel x:Name="PageConnections" Visibility="Collapsed">
                        <TextBlock Text="{l:Tr SetConnections}" Style="{StaticResource PageTitle}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{l:Tr SetConnPerFile}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="ConnectionsBox" Width="110" HorizontalAlignment="Left"/>
                                <TextBlock Text="{l:Tr SetConnPerFileHint}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                                <TextBlock Text="{l:Tr SetMaxConcurrent}" Style="{StaticResource FieldLabel}" Visibility="Collapsed"/>
                                <TextBox x:Name="ConcurrentBox" Style="{StaticResource SmallBox}" Visibility="Collapsed"/>
                                <TextBlock Text="{l:Tr SetRetries}" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="RetriesBox" Style="{StaticResource SmallBox}"/>
                                <TextBlock Text="{l:Tr SetSpeedLimit}" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="SpeedBox" Style="{StaticResource SmallBox}"/>
                                <TextBlock Text="{l:Tr SetPort}" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="PortBox" Style="{StaticResource SmallBox}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Scheduler -->
                    <StackPanel x:Name="PageScheduler" Visibility="Collapsed">
                        <TextBlock Text="{l:Tr SetScheduler}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{l:Tr SchedIntro}" Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" Margin="0,-6,0,14"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="StartEnabledBox" Style="{StaticResource Check}" Content="{l:Tr SchedStart}"
                                              MinWidth="190" VerticalAlignment="Center"/>
                                    <TextBox x:Name="StartTimeBox" Style="{StaticResource SmallBox}" Width="90"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <CheckBox x:Name="StopEnabledBox" Style="{StaticResource Check}" Content="{l:Tr SchedStop}"
                                              MinWidth="190" VerticalAlignment="Center"/>
                                    <TextBox x:Name="StopTimeBox" Style="{StaticResource SmallBox}" Width="90"/>
                                </StackPanel>
                                <TextBlock Text="{l:Tr SchedDays}" Style="{StaticResource FieldLabel}" Margin="0,18,0,8"/>
                                <WrapPanel x:Name="DaysPanel"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <CheckBox x:Name="ShutdownBox" Style="{StaticResource Check}" Content="{l:Tr SchedShutdown}"/>
                        </Border>
                    </StackPanel>

                    <!-- Browser -->
                    <StackPanel x:Name="PageBrowser" Visibility="Collapsed">
                        <TextBlock Text="{l:Tr SetBrowser}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{l:Tr BrowserIntro}" Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" Margin="0,-6,0,14"/>

                        <Border x:Name="ExtStatusCard" Style="{StaticResource Card}" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ExtStatusBadge" Width="36" Height="36" CornerRadius="18" VerticalAlignment="Center">
                                    <TextBlock x:Name="ExtStatusGlyph" Style="{StaticResource Glyph}" FontSize="16" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ExtStatusText" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ExtStatusHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="{l:Tr AddToBrowserTitle}" Style="{StaticResource FieldLabel}" Margin="2,18,0,8"/>
                        <Border Style="{StaticResource Card}" Padding="6">
                            <StackPanel x:Name="BrowsersPanel"/>
                        </Border>

                        <Border x:Name="ManualSteps" Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{l:Tr BrowserHowTitle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <StackPanel x:Name="StepsPanel"/>
                                <TextBlock Text="{l:Tr BrowserFolder}" Style="{StaticResource FieldLabel}"/>
                                <DockPanel>
                                    <Button x:Name="CopyButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                            Content="{l:Tr CopyPath}" Click="CopyPath_Click"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                            Content="{l:Tr OpenFolder}" Click="OpenExtension_Click"/>
                                    <TextBox x:Name="ExtensionPathBox" IsReadOnly="True" Height="36" VerticalContentAlignment="Center"
                                             FlowDirection="LeftToRight"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <!-- Appearance -->
                    <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                        <TextBlock Text="{l:Tr SetAppearance}" Style="{StaticResource PageTitle}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{l:Tr SetLanguage}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="LanguageBox" Width="240" HorizontalAlignment="Left"/>
                                <TextBlock Text="{l:Tr SetTheme}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="ThemeBox" Width="240" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- About -->
                    <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}" Padding="24">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Image x:Name="AboutLogo" Width="64" Height="64"/>
                                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="SwiftGet" Style="{StaticResource H1}" FontSize="24"/>
                                        <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{l:Tr AboutText}" Margin="0,18,0,0" FontSize="14" TextWrapping="Wrap"/>
                                <TextBlock Text="{l:Tr AboutLicense}" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0"
                                        Click="Github_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE774;" FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="{l:Tr AboutGithub}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
