<Window x:Class="SwiftGet.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SwiftGet.Core"
        Title="{l:Tr UpdTitle}" Width="560" Height="480" ResizeMode="NoResize"
        FlowDirection="{Binding Flow, Source={x:Static l:Loc.I}}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="24,20,24,22">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource SuccessSoft}">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="21" Foreground="{DynamicResource Success}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="HeadText" Style="{StaticResource H2}" FontSize="18"/>
                <TextBlock x:Name="SubText" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
            <ProgressBar x:Name="Bar" Style="{StaticResource ThinProgress}" Margin="0,14,0,0" Visibility="Collapsed"/>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
            <DockPanel Margin="0,16,0,0" LastChildFill="False">
                <Button x:Name="InstallButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" IsDefault="True" Click="Install_Click"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Content="{l:Tr UpdLater}" IsCancel="True"/>
                <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Content="{l:Tr UpdSkip}" Click="Skip_Click"/>
            </DockPanel>
        </StackPanel>

        <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="4">
            <TextBox x:Name="NotesBox" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                     Foreground="{DynamicResource Text}" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" Padding="8"/>
        </Border>
    </DockPanel>
</Window>
