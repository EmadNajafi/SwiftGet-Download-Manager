<Window x:Class="SwiftGet.Views.AddDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SwiftGet.Core"
        Title="{l:Tr NewDownload}" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        FlowDirection="{Binding Flow, Source={x:Static l:Loc.I}}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="26,22,26,24">
        <!-- header -->
        <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource IconTile}" Width="46" Height="46" CornerRadius="12">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="21" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{l:Tr NewDownload}" Style="{StaticResource H1}" FontSize="19"/>
                <TextBlock Text="{l:Tr AddSubtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Text="{l:Tr FieldUrl}" Style="{StaticResource FieldLabel}" Margin="0,22,0,6"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" MinWidth="88" Margin="8,0,0,0"
                    Content="{l:Tr Check}" Click="Probe_Click"/>
            <TextBox x:Name="UrlBox" Height="36" VerticalContentAlignment="Center" FlowDirection="LeftToRight"
                     LostFocus="UrlBox_LostFocus"/>
        </DockPanel>

        <TextBlock Text="{l:Tr FieldFileName}" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NameBox" Height="36" VerticalContentAlignment="Center" FlowDirection="LeftToRight"
                 TextChanged="NameBox_TextChanged"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{l:Tr FieldCategory}" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CategoryBox" Height="36" SelectionChanged="CategoryBox_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{Binding Brush}"
                                           FontSize="14" Margin="0,0,9,0"/>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{l:Tr FieldSaveTo}" Style="{StaticResource FieldLabel}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" MinWidth="40" Width="40" Padding="0"
                            Margin="8,0,0,0" Click="Browse_Click" ToolTip="{l:Tr Browse}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" FontSize="14"/>
                    </Button>
                    <TextBox x:Name="FolderBox" Height="36" VerticalContentAlignment="Center" FlowDirection="LeftToRight"/>
                </DockPanel>
            </StackPanel>
        </Grid>

        <!-- file information -->
        <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="16,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{l:Tr InfoSize}" Style="{StaticResource Caption}"/>
                        <TextBlock x:Name="SizeValue" Text="—" FontWeight="SemiBold" FontSize="14" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{l:Tr InfoResume}" Style="{StaticResource Caption}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock x:Name="ResumeGlyph" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ResumeValue" Text="—" FontWeight="SemiBold" FontSize="14"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{l:Tr InfoType}" Style="{StaticResource Caption}"/>
                        <TextBlock x:Name="TypeValue" Text="—" FontWeight="SemiBold" FontSize="14" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
                <Rectangle Height="1" Fill="{DynamicResource Border}" Margin="0,12,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="InfoGlyph" Style="{StaticResource Glyph}" Text="&#xE946;" FontSize="13"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" VerticalAlignment="Top" Padding="0,2,0,0"/>
                    <TextBlock x:Name="InfoText" Style="{StaticResource Caption}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="520"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- buttons -->
        <DockPanel Margin="0,22,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" IsDefault="True" Click="Start_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="13" Margin="0,0,8,0"/>
                    <TextBlock Text="{l:Tr StartDownload}"/>
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Later_Click"
                    Content="{l:Tr DownloadLater}"/>
            <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" IsCancel="True" Content="{l:Tr Cancel}"/>
        </DockPanel>
    </StackPanel>
</Window>
