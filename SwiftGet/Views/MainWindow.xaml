<Window x:Class="SwiftGet.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SwiftGet.Core"
        xmlns:v="clr-namespace:SwiftGet.Views"
        Title="SwiftGet" Height="680" Width="1160" MinWidth="900" MinHeight="460"
        FlowDirection="{Binding Flow, Source={x:Static l:Loc.I}}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- big toolbar button: icon above label -->
        <Style x:Key="BigTool" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinWidth" Value="74"/>
            <Setter Property="Height" Value="62"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BigGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,5"/>
        </Style>
        <Style x:Key="BigLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- category tree item -->
        <HierarchicalDataTemplate x:Key="NavTemplate" DataType="{x:Type v:NavEntry}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,3">
                <TextBlock Text="{Binding Glyph}" FontSize="15" Margin="0,0,8,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                            <Setter Property="Foreground" Value="{Binding GlyphBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GlyphBrush}" Value="{x:Null}">
                                    <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="8,0" TextElement.Foreground="{DynamicResource Text}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- full row template so the Windows 11 theme can't recolor (or dim) row text -->
        <Style x:Key="GridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True"
                                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <DockPanel>
                                    <Path x:Name="SortArrow" DockPanel.Dock="Right" Width="8" Height="5" Margin="6,0,0,0" Stretch="Fill"
                                          Fill="{DynamicResource TextTertiary}" Visibility="Collapsed" VerticalAlignment="Center"
                                          Data="M0,0 L4,5 L8,0 Z"/>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M0,5 L4,0 L8,5 Z"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ============================ menu bar ============================ -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}" Padding="4,2">
            <MenuItem Header="{l:Tr MnTasks}">
                <MenuItem Header="{l:Tr AddUrl}" InputGestureText="Ctrl+N" Click="AddUrl_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="14"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr MnBatch}" InputGestureText="Ctrl+B" Click="Batch_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE8B3;" FontSize="14"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr MnGrabber}" Click="Grabber_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE774;" FontSize="14"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{l:Tr MnImport}" Click="Import_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE8B5;" FontSize="14"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr MnExport}" Click="Export_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xEDE1;" FontSize="14"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{l:Tr TrayExit}" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="{l:Tr MnDownloads}">
                <MenuItem Header="{l:Tr MnResumeAll}" Click="ResumeAll_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="14"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr StopAll}" Click="PauseAll_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE71A;" FontSize="14"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr MnRefresh}" Click="Refresh_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="14"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr MnDeleteCompleted}" Click="DeleteCompleted_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="14"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="StartQueueMenu" Header="{l:Tr StartQueue}" SubmenuOpened="QueueMenu_Opened">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="14"/></MenuItem.Icon>
                    <MenuItem Header="…"/>
                </MenuItem>
                <MenuItem x:Name="StopQueueMenu" Header="{l:Tr StopQueue}" SubmenuOpened="QueueMenu_Opened">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE71A;" FontSize="14"/></MenuItem.Icon>
                    <MenuItem Header="…"/>
                </MenuItem>
                <MenuItem Header="{l:Tr Scheduler}" Click="Schedule_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE787;" FontSize="14"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr MnSpeedLimit}" Click="SpeedLimit_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xEC4A;" FontSize="14"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr Options}" Click="Settings_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="14"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{l:Tr MnHelp}">
                <MenuItem Header="{l:Tr MnBrowser}" Click="BrowserSetup_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xEA86;" FontSize="14"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr MnCheckUpdates}" Click="CheckUpdates_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE895;" FontSize="14"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr AboutGithub}" Click="Project_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE774;" FontSize="14"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{l:Tr SetAbout}" Click="About_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" FontSize="14"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- ============================ toolbar ============================ -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel>
                <Border DockPanel.Dock="Right" Width="220" Height="32" CornerRadius="6" Background="{DynamicResource Bg}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1" VerticalAlignment="Center" Margin="10,0,4,0">
                    <Grid>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0"
                                   HorizontalAlignment="Left" Foreground="{DynamicResource TextTertiary}"/>
                        <TextBlock x:Name="SearchPlaceholder" Text="{l:Tr SearchPlaceholder}" Margin="32,0,8,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextTertiary}" IsHitTestVisible="False"/>
                        <TextBox x:Name="SearchBox" Margin="28,0,6,0" Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center" Foreground="{DynamicResource Text}"
                                 CaretBrush="{DynamicResource Text}" TextChanged="SearchBox_TextChanged">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="4,0"/>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource BigTool}" Click="AddUrl_Click" ToolTip="Ctrl+N">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BigGlyph}" Text="&#xE710;" Foreground="{DynamicResource Accent}"/>
                            <TextBlock Style="{StaticResource BigLabel}" Text="{l:Tr AddUrl}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BigTool}" Click="Resume_Click">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BigGlyph}" Text="&#xE768;" Foreground="{DynamicResource Success}"/>
                            <TextBlock Style="{StaticResource BigLabel}" Text="{l:Tr Resume}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BigTool}" Click="Pause_Click">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BigGlyph}" Text="&#xE769;" Foreground="{DynamicResource Warning}"/>
                            <TextBlock Style="{StaticResource BigLabel}" Text="{l:Tr Stop}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BigTool}" Click="PauseAll_Click">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BigGlyph}" Text="&#xE71A;" Foreground="{DynamicResource Danger}"/>
                            <TextBlock Style="{StaticResource BigLabel}" Text="{l:Tr StopAll}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BigTool}" Click="Delete_Click">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BigGlyph}" Text="&#xE74D;" Foreground="{DynamicResource Danger}"/>
                            <TextBlock Style="{StaticResource BigLabel}" Text="{l:Tr Delete}"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Margin="8,8" Fill="{DynamicResource Border}"/>
                    <Button x:Name="StartQueueButton" Style="{StaticResource BigTool}" Click="StartQueue_Click">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BigGlyph}" Text="&#xE8FD;" Foreground="{DynamicResource Accent}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource BigLabel}" Text="{l:Tr StartQueue}"/>
                                <TextBlock x:Name="StartQueueArrow" Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="8" Margin="4,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopQueueButton" Style="{StaticResource BigTool}" Click="StopQueue_Click">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BigGlyph}" Text="&#xE15B;" Foreground="{DynamicResource Accent}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource BigLabel}" Text="{l:Tr StopQueue}"/>
                                <TextBlock x:Name="StopQueueArrow" Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="8" Margin="4,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BigTool}" Click="Schedule_Click">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BigGlyph}" Text="&#xE787;" Foreground="{DynamicResource Accent}"/>
                            <TextBlock Style="{StaticResource BigLabel}" Text="{l:Tr Scheduler}"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Margin="8,8" Fill="{DynamicResource Border}"/>
                    <Button Style="{StaticResource BigTool}" Click="Settings_Click">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BigGlyph}" Text="&#xE713;" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Style="{StaticResource BigLabel}" Text="{l:Tr Options}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================ update banner ============================ -->
        <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource SuccessSoft}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="30" Height="30" Margin="6,0,0,0"
                        Click="UpdateDismiss_Click" ToolTip="{l:Tr Close}">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="11"/>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Height="32" MinWidth="0" Padding="14,0" Margin="8,0,0,0"
                        Click="UpdateNow_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="12" Margin="0,0,7,0"/>
                        <TextBlock Text="{l:Tr UpdNow}"/>
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Height="32" MinWidth="0" Padding="14,0"
                        Click="UpdateNow_Click" Content="{l:Tr UpdWhatsNew}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" FontSize="16" Foreground="{DynamicResource Success}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="UpdateBannerText" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================ status bar ============================ -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Ellipse x:Name="BridgeDot" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="BridgeText" Style="{StaticResource Caption}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,0,6,0"/>
                    <TextBlock x:Name="SpeedStatus" Style="{StaticResource Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    <Rectangle Width="1" Margin="14,2" Fill="{DynamicResource Border}"/>
                    <TextBlock x:Name="ActiveStatus" Style="{StaticResource Caption}"/>
                    <Rectangle Width="1" Margin="14,2" Fill="{DynamicResource Border}"/>
                    <Ellipse x:Name="QueueDot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="QueueStatus" Style="{StaticResource Caption}"/>
                    <Rectangle Width="1" Margin="14,2" Fill="{DynamicResource Border}"/>
                    <TextBlock x:Name="CountStatus" Style="{StaticResource Caption}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" MinWidth="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============================ category tree ============================ -->
            <Border Background="{DynamicResource Surface}">
                <TreeView x:Name="NavTree" BorderThickness="0" Background="Transparent" Padding="4,8"
                          ItemTemplate="{StaticResource NavTemplate}" SelectedItemChanged="NavTree_SelectedItemChanged"
                          PreviewMouseRightButtonDown="NavTree_PreviewMouseRightButtonDown" ContextMenuOpening="NavTree_ContextMenuOpening">
                    <TreeView.ContextMenu>
                        <ContextMenu x:Name="NavMenu" FlowDirection="{Binding Flow, Source={x:Static l:Loc.I}}"/>
                    </TreeView.ContextMenu>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Border>
            <GridSplitter Grid.Column="1" Width="1" Background="{DynamicResource Border}" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

            <!-- ============================ downloads table ============================ -->
            <DataGrid x:Name="DownloadGrid" Grid.Column="2" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" CanUserReorderColumns="True"
                      SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource Surface}" RowBackground="Transparent" BorderThickness="0"
                      RowHeight="30" FontSize="13" Foreground="{DynamicResource Text}"
                      ColumnHeaderStyle="{StaticResource GridHeader}" CellStyle="{StaticResource GridCell}"
                      RowStyle="{StaticResource GridRow}" EnableRowVirtualization="True"
                      MouseDoubleClick="DownloadGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{l:Tr ColName}" Width="*" MinWidth="200" SortMemberPath="FileName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding CategoryGlyph}" Foreground="{Binding CategoryBrush}"
                                               FontSize="15" Margin="0,0,9,0"/>
                                    <TextBlock Text="{Binding FileName, Mode=OneWay}" Style="{StaticResource CellText}"
                                               ToolTip="{Binding FullPath, Mode=OneWay}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{l:Tr ColSize}" Width="95" Binding="{Binding SizeText, Mode=OneWay}" ElementStyle="{StaticResource CellText}" SortMemberPath="TotalSize"/>
                    <DataGridTemplateColumn Header="{l:Tr ColStatus}" Width="120" SortMemberPath="Progress">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="St" Text="{Binding GridStatusText, Mode=OneWay}" Style="{StaticResource CellText}" ToolTip="{Binding ErrorMessage, Mode=OneWay}"/>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                        <Setter TargetName="St" Property="Foreground" Value="{DynamicResource Success}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                        <Setter TargetName="St" Property="Foreground" Value="{DynamicResource Danger}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                        <Setter TargetName="St" Property="Foreground" Value="{DynamicResource Accent}"/>
                                        <Setter TargetName="St" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{l:Tr ColTimeLeft}" Width="105" Binding="{Binding GridEtaText, Mode=OneWay}" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="{l:Tr ColRate}" Width="110" Binding="{Binding GridSpeedText, Mode=OneWay}" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="{l:Tr ColAdded}" Width="135" Binding="{Binding DateAddedText, Mode=OneWay}" ElementStyle="{StaticResource CellText}" SortMemberPath="DateAdded"/>
                </DataGrid.Columns>

                <DataGrid.ContextMenu>
                    <ContextMenu FlowDirection="{Binding Flow, Source={x:Static l:Loc.I}}" Opened="ContextMenu_Opened">
                        <MenuItem Header="{l:Tr MenuOpenFile}" Click="OpenFile_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" FontSize="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{l:Tr MenuOpenFolder}" Click="OpenFolder_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" FontSize="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{l:Tr MenuDetails}" Click="Details_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" FontSize="14"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{l:Tr Resume}" Click="Resume_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{l:Tr Stop}" Click="Pause_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE769;" FontSize="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{l:Tr MenuRestart}" Click="Restart_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="14"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem x:Name="AddToQueueMenu" Header="{l:Tr MenuAddQueue}">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" FontSize="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{l:Tr MenuRemoveQueue}" Click="RemoveFromQueue_Click"/>
                        <MenuItem Header="{l:Tr MnRefresh}" Click="Refresh_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="14"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{l:Tr MenuCopyLink}" Click="CopyLink_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE71B;" FontSize="14"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{l:Tr MenuDelete}" Click="Delete_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{l:Tr MenuDeleteFile}" Click="DeleteWithFile_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="14"/></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
