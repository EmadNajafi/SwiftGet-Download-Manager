<Window x:Class="SwiftGet.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SwiftGet.Core"
        xmlns:m="clr-namespace:SwiftGet.Models"
        Title="SwiftGet" Height="740" Width="1220" MinWidth="1000" MinHeight="520"
        FlowDirection="{Binding Flow, Source={x:Static l:Loc.I}}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- one row in the download list -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type m:DownloadItem}">
            <Grid MinHeight="52">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource IconTile}" Width="44" Height="44" Background="{Binding CategorySoftBrush}">
                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding CategoryGlyph}" Foreground="{Binding CategoryBrush}"
                               FontSize="19" HorizontalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FileName, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath, Mode=OneWay}"/>
                    <TextBlock x:Name="Subline" Text="{Binding SublineText, Mode=OneWay}" Style="{StaticResource Caption}"
                               Margin="0,3,0,7" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar x:Name="Bar" Style="{StaticResource ThinProgress}" Value="{Binding Progress, Mode=OneWay}"/>
                </StackPanel>

                <Border x:Name="Pill" Grid.Column="2" Style="{StaticResource Pill}" VerticalAlignment="Center">
                    <TextBlock x:Name="PillText" Text="{Binding PillText, Mode=OneWay}" Foreground="{DynamicResource Accent}"
                               FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </Border>

                <StackPanel x:Name="Actions" Grid.Column="3" Orientation="Horizontal" Margin="10,0,0,0" Opacity="0.6"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Click="RowPrimary_Click" ToolTip="{Binding PrimaryTip, Mode=OneWay}">
                        <TextBlock Style="{StaticResource Glyph}" Text="{Binding PrimaryGlyph, Mode=OneWay}" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="RowFolder_Click" ToolTip="{l:Tr MenuOpenFolder}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="RowDetails_Click" ToolTip="{l:Tr MenuDetails}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static m:DownloadStatus.Completed}">
                    <Setter TargetName="Bar" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Subline" Property="Margin" Value="0,3,0,0"/>
                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SuccessSoft}"/>
                    <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static m:DownloadStatus.Paused}">
                    <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource Warning}"/>
                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource WarningSoft}"/>
                    <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource Warning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static m:DownloadStatus.Queued}">
                    <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource TextTertiary}"/>
                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource NeutralSoft}"/>
                    <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static m:DownloadStatus.Error}">
                    <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource Danger}"/>
                    <Setter TargetName="Subline" Property="Foreground" Value="{DynamicResource Danger}"/>
                    <Setter TargetName="Bar" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource DangerSoft}"/>
                    <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource Danger}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                    <Setter TargetName="Actions" Property="Opacity" Value="1"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- sidebar entry (header or link) -->
        <DataTemplate x:Key="NavTemplate">
            <Grid>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionLabel}" Margin="2,10,0,0"
                           Visibility="{Binding IsHeader, Converter={StaticResource BoolVis}}"/>
                <Grid Visibility="{Binding IsHeader, Converter={StaticResource InvBoolVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Glyph}" FontSize="15" HorizontalAlignment="Center" Margin="0,0,6,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                <Setter Property="Foreground" Value="{Binding GlyphBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GlyphBrush}" Value="{x:Null}">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================ sidebar ============================ -->
        <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,18">
                    <Image x:Name="LogoImage" Width="36" Height="36"/>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SwiftGet" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="{l:Tr AppTagline}" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </StackPanel>

                <Button DockPanel.Dock="Top" Style="{StaticResource AccentButton}" Height="42" Click="AddUrl_Click"
                        ToolTip="Ctrl+N">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="14" Margin="0,0,9,0"/>
                        <TextBlock Text="{l:Tr NewDownload}"/>
                    </StackPanel>
                </Button>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,10,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="BridgeDot" Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BridgeText" Grid.Column="1" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                    <Button Style="{StaticResource NavButton}" Click="Settings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="15" Margin="2,0,12,0" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{l:Tr Settings}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ListBox x:Name="NavList" Style="{StaticResource PlainList}" Margin="0,8,0,0"
                         ItemContainerStyle="{StaticResource NavItem}" ItemTemplate="{StaticResource NavTemplate}"
                         SelectionChanged="NavList_SelectionChanged"/>
            </DockPanel>
        </Border>

        <!-- ============================ main ============================ -->
        <DockPanel Grid.Column="1">
            <!-- toolbar -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="0,0,0,1" Padding="14,9">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Width="230" Height="36" CornerRadius="8" Background="{DynamicResource Bg}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <Grid>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="13" Margin="12,0,0,0"
                                       HorizontalAlignment="Left" Foreground="{DynamicResource TextTertiary}"/>
                            <TextBlock x:Name="SearchPlaceholder" Text="{l:Tr SearchPlaceholder}" Margin="36,0,8,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextTertiary}" IsHitTestVisible="False"/>
                            <TextBox x:Name="SearchBox" Margin="32,0,6,0" Background="Transparent" BorderThickness="0"
                                     VerticalContentAlignment="Center" Foreground="{DynamicResource Text}"
                                     CaretBrush="{DynamicResource Text}" TextChanged="SearchBox_TextChanged">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="4,0"/>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ToolButton}" Click="Resume_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE768;"/>
                                <TextBlock Text="{l:Tr Resume}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Click="Pause_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE769;"/>
                                <TextBlock Text="{l:Tr Pause}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Click="PauseAll_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE71A;"/>
                                <TextBlock Text="{l:Tr StopAll}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Click="Delete_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE74D;" Foreground="{DynamicResource Danger}"/>
                                <TextBlock Text="{l:Tr Delete}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Rectangle Width="1" Margin="8,6" Fill="{DynamicResource Border}"/>
                        <Button x:Name="StartQueueButton" Style="{StaticResource ToolButton}" Click="StartQueue_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE8FD;"/>
                                <TextBlock Text="{l:Tr StartQueue}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="StopQueueButton" Style="{StaticResource ToolButton}" Click="StopQueue_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE15B;"/>
                                <TextBlock Text="{l:Tr StopQueue}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Click="Schedule_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE787;"/>
                                <TextBlock Text="{l:Tr Scheduler}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- status bar -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="0,1,0,0" Padding="18,7">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="13" Foreground="{DynamicResource Accent}" Margin="0,0,7,0"/>
                    <TextBlock x:Name="SpeedStatus" Style="{StaticResource Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    <Rectangle Width="1" Margin="16,2" Fill="{DynamicResource Border}"/>
                    <TextBlock x:Name="ActiveStatus" Style="{StaticResource Caption}"/>
                    <Rectangle Width="1" Margin="16,2" Fill="{DynamicResource Border}"/>
                    <Ellipse x:Name="QueueDot" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="QueueStatus" Style="{StaticResource Caption}"/>
                </StackPanel>
            </Border>

            <!-- page header -->
            <DockPanel DockPanel.Dock="Top" Margin="22,18,22,12">
                <ComboBox x:Name="SortBox" DockPanel.Dock="Right" Width="160" SelectionChanged="SortBox_SelectionChanged"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="PageCount" Style="{StaticResource Caption}" Margin="12,0,0,3" VerticalAlignment="Bottom"/>
                </StackPanel>
            </DockPanel>

            <Grid>
                <ListView x:Name="DownloadList" Margin="16,0,10,4" Padding="6,0,6,0" Background="Transparent" BorderThickness="0"
                          SelectionMode="Extended" ItemTemplate="{StaticResource RowTemplate}"
                          ItemContainerStyle="{StaticResource RowItem}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.IsVirtualizing="True"
                          MouseDoubleClick="DownloadList_MouseDoubleClick">
                    <ListView.Template>
                        <ControlTemplate TargetType="ListView">
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListView.Template>
                    <ListView.ContextMenu>
                        <ContextMenu FlowDirection="{Binding Flow, Source={x:Static l:Loc.I}}">
                            <MenuItem Header="{l:Tr MenuOpenFile}" Click="OpenFile_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" FontSize="14"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{l:Tr MenuOpenFolder}" Click="OpenFolder_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" FontSize="14"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{l:Tr MenuDetails}" Click="Details_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" FontSize="14"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="{l:Tr Resume}" Click="Resume_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="14"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{l:Tr Pause}" Click="Pause_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE769;" FontSize="14"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{l:Tr MenuRestart}" Click="Restart_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="14"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="{l:Tr MenuAddQueue}" Click="AddToQueue_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" FontSize="14"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{l:Tr MenuRemoveQueue}" Click="RemoveFromQueue_Click"/>
                            <Separator/>
                            <MenuItem Header="{l:Tr MenuCopyLink}" Click="CopyLink_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE71B;" FontSize="14"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="{l:Tr MenuDelete}" Click="Delete_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="14"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{l:Tr MenuDeleteFile}" Click="DeleteWithFile_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="14"/></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ListView.ContextMenu>
                </ListView>

                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Margin="0,0,0,60">
                    <Border Width="84" Height="84" CornerRadius="42" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="36" Foreground="{DynamicResource Accent}"
                                   HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{l:Tr EmptyTitle}" Style="{StaticResource H2}" Margin="0,18,0,6" HorizontalAlignment="Center"/>
                    <TextBlock Text="{l:Tr EmptyHint}" Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap"
                               TextAlignment="Center" HorizontalAlignment="Center"/>
                    <Button Style="{StaticResource AccentButton}" Margin="0,20,0,0" HorizontalAlignment="Center" Click="AddUrl_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="{l:Tr NewDownload}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
